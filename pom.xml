<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        One parent for the whole Aero estate: Java level, encoding, plugin versions and the
        dependency BOM. relativePath is empty on purpose - this repository is cloned on its
        own, so the parent is resolved from the artifact repository, not a sibling directory.
    -->
    <parent>
        <groupId>com.boeing.aero</groupId>
        <artifactId>aero-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>com.boeing</groupId>
    <artifactId>dep-graph-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Dependency Graph - Parent</name>
    <description>
        A full-stack application for analysing a multi-module Maven project two ways at
        once: what its poms declare (the build plane - modules, dependencies, version
        skew, and the BOM that would remove it) and what its bytecode actually uses (the
        code plane - types, methods, and the call graph between them). Both planes land
        in one Neo4J graph, joined by an edge from each type to the module or artifact it
        came from, so "which dependency does this class actually need" is a traversal
        rather than a guess.
    </description>

    <modules>
        <module>dep-graph-core</module>
    </modules>

    <!--
        Java level, encoding, plugin versions and every third-party dependency version come
        from aero-parent / aero-bom. Build those first:

            mvn -f ../platform/pom.xml install

        To build for a different Java level:

            mvn -Djava.version=25 clean verify
            JAVA_VERSION=25 docker compose build
    -->

    <dependencyManagement>
        <dependencies>
            <!--
                The only version this repository decides for itself: its own module, which
                moves with ${project.version} and so cannot come from a shared BOM.
            -->
            <dependency>
                <groupId>com.boeing</groupId>
                <artifactId>dep-graph-core</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <!-- Version and <release> inherited from aero-parent. -->
                    <configuration>
                        <!--
                            Lombok is an annotation processor, and from JDK 23 javac no
                            longer runs processors it merely finds on the classpath.
                            Declaring the path explicitly is what keeps @Slf4j and friends
                            working on 25.
                        -->
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
