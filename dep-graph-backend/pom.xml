<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.boeing</groupId>
        <artifactId>dep-graph-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>dep-graph-backend</artifactId>
    <name>dep-graph - Backend</name>
    <description>
        REST API over the analysis engine. Runs scans, writes both planes into Neo4J with
        hand-written Cypher, and serves a catalogue of canned queries plus a read-only
        Cypher endpoint.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.boeing</groupId>
            <artifactId>dep-graph-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            The raw driver and hand-written Cypher, not Spring Data Neo4J. The estate's
            other two scanners made the same call: the writes here are bulk UNWIND
            batches and the reads are arbitrary user-supplied Cypher, and an OGM helps
            with neither.
        -->
        <dependency>
            <groupId>org.neo4j.driver</groupId>
            <artifactId>neo4j-java-driver</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                        Spring resolves @PathVariable and @RequestParam names by reflection
                        unless they are spelled out in the annotation, and javac only keeps
                        parameter names with this flag. spring-boot-starter-parent sets it;
                        we inherit aero-parent instead, so it has to be set here.

                        Without it every controller method taking a parameter fails at
                        request time, not at build time - the context starts cleanly and
                        every such endpoint returns 500.
                    -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
