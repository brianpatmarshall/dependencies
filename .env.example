# dep-graph - environment
# =======================
# Copy to .env and adjust. docker compose reads .env automatically.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# SCAN_ROOT - the source tree you want to analyse
# ---------------------------------------------------------------------------
# Mounted read-only into the backend at /projects. A project at $SCAN_ROOT/my-app is then
# scanned by entering /projects/my-app in the UI.
#
# Defaults to ./projects, which holds only a .gitkeep - fine for dropping one repository
# in, not for scanning an estate in place.
SCAN_ROOT=/extended/home/src/java/soheili/aero

# ---------------------------------------------------------------------------
# M2_REPO - the local Maven repository
# ---------------------------------------------------------------------------
# Mounted read-only at /m2. The code plane reads dependency jars from here, so a scan with
# the wrong path silently produces a graph with no library types in it at all.
# M2_REPO=/home/you/.m2/repository

# ---------------------------------------------------------------------------
# Neo4J credentials
# ---------------------------------------------------------------------------
# Neo4J stores the password inside the data volume on first start, so changing this later
# does nothing until `docker compose down -v` (which discards the graph) or an in-container
# reset.
NEO4J_PASSWORD=depgraph

# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------
# BACKEND_PORT is load-bearing beyond compose: dep-graph-frontend/vite.config.ts proxies
# `npm run dev` to http://localhost:9094, and springdoc advertises the same address.
# Change it and you must change SPRINGDOC_SERVER_URL and the vite fallback too.
# FRONTEND_PORT=9093
# BACKEND_PORT=9094
# NEO4J_HTTP_PORT=7476
# NEO4J_BOLT_PORT=7689
# SPRINGDOC_SERVER_URL=http://localhost:9094

# ---------------------------------------------------------------------------
# JAVA_VERSION - JDK the backend image runs on
# ---------------------------------------------------------------------------
# Defaults to 21, matching <java.version> in aero-parent.
# JAVA_VERSION=21
